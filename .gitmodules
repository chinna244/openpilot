# zoompilot develop: temporary chinna244 fork pins so a clean C4 install can
# fetch the reviewed Mazda TJA/MADS + MRCC independence commits before they
# land on the org remotes. Touch this file to force `git submodule sync`.
[submodule "panda"]
  path = panda
  url = https://github.com/chinna244/panda.git
[submodule "opendbc"]
  path = opendbc_repo
  url = https://github.com/chinna244/opendbc-sunnypilot.git
[submodule "msgq"]
  path = msgq_repo
  url = https://github.com/sunnypilot/msgq.git
[submodule "rednose_repo"]
  path = rednose_repo
  url = https://github.com/commaai/rednose.git
[submodule "teleoprtc_repo"]
  path = teleoprtc_repo
  url = https://github.com/commaai/teleoprtc
[submodule "tinygrad"]
  path = tinygrad_repo
  url = https://github.com/sunnypilot/tinygrad.git
[submodule "sunnypilot/neural_network_data"]
	path = openpilot/sunnypilot/neural_network_data
  url = https://github.com/sunnypilot/neural-network-data.git
