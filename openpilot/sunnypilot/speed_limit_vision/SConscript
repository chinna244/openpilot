import ctypes.util
import glob
import os
from SCons.Script import Value
from openpilot.common.transformations.camera import _ar_ox_fisheye, _os_fisheye
from openpilot.system.camerad.cameras.nv12_info import get_nv12_info

Import('env', 'arch')

# same tinygrad setup as selfdrive/modeld/SConscript
if os.getenv('SKIP_TINYGRAD_COMPILE') or (arch not in ('comma_arm64', 'Darwin') and ctypes.util.find_library('LLVM') is None):
  Return()

lenv = env.Clone()
lenv.PrependENVPath('PYTHONPATH', Dir('#tinygrad_repo').abspath)

tinygrad_root = env.Dir("#").abspath
tinygrad_files = ["#"+x for x in glob.glob(env.Dir("#tinygrad_repo").relpath + "/**", recursive=True, root_dir=tinygrad_root)
                  if 'pycache' not in x and os.path.isfile(os.path.join(tinygrad_root, x))]

if arch == 'comma_arm64':
  # IMAGE=0: with modeld's IMAGE=1 the Adreno compiler fails on these models' convs (2026-11-01)
  tg_flags = 'DEV=QCOM IMAGE=0 FLOAT16=1 NOLOCALS=1 JIT_BATCH_SIZE=0 OPENPILOT_HACKS=1'
else:
  tg_flags = 'DEV=METAL JIT=2' if arch == 'Darwin' else 'DEV=CPU:LLVM'
mac_brew_string = f'HOME={os.path.expanduser("~")}' if arch == 'Darwin' else ''

taskset = 'taskset -c 0-7 ' if arch == 'comma_arm64' else ''

compiler = File('compile_sign_models.py').abspath
deps = [compiler, File('#openpilot/system/camerad/cameras/nv12_info.py')]
for name in ('speed_limit_us_detector', 'speed_limit_us_value_classifier'):
  onnx_path = File(f'models/{name}.onnx').abspath
  for cam_w, cam_h in [(c.width, c.height) for c in (_ar_ox_fisheye, _os_fisheye)]:
    stride, y_height, uv_height, frame_size = get_nv12_info(cam_w, cam_h)
    pkl_path = File(f'models/{name}_{cam_w}x{cam_h}_tinygrad.pkl').abspath
    # a failed compile leaves the sign reader off ("Missing compiled vision models"), not the whole build failed
    cmd = (f'{tg_flags} {mac_brew_string} {taskset}python3 "{compiler}" "{onnx_path}" "{pkl_path}" '
           f'--frame {cam_w},{cam_h},{stride},{y_height},{uv_height},{frame_size} --benchmark-runs 1 '
           f'|| (rm -f "{pkl_path}"; echo "speed_limit_vision: {name} compile failed, reader off")')
    lenv.Command(pkl_path, tinygrad_files + deps + [onnx_path, Value(cmd)], cmd)
